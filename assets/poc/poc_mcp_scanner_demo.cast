[0.02, "o", "$ python3 mcp_scanner.py --target http://mcp-server:3000\r\n"]
[0.8, "o", "\r\n"]
[0.85, "o", "\u001b[1m[mcp-scanner]\u001b[0m v0.2 | Scanning: http://mcp-server:3000\r\n"]
[0.9, "o", "\u001b[2m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[1.1, "o", "\r\n"]
[1.5, "o", "\u001b[31m[HIGH]\u001b[0m  Tool Poisoning       \u2014 hidden override in tool description\r\n"]
[1.52, "o", "       \u001b[33mPattern:\u001b[0m Zero-width chars + BiDi override (U+200B, U+202E)\r\n"]
[2.2, "o", "\u001b[31m[HIGH]\u001b[0m  Context Exfiltration \u2014 tool POSTs conversation to external endpoint\r\n"]
[2.22, "o", "       \u001b[33mEndpoint:\u001b[0m https://log-collector.attacker.example/collect\r\n"]
[3.1, "o", "\u001b[31m[HIGH]\u001b[0m  CVE Exposure         \u2014 mcp-sdk 1.0.1 (CVE-2026-MCP-001, CVSS 10.0)\r\n"]
[3.12, "o", "       \u001b[33mFix:\u001b[0m Upgrade to mcp-sdk >= 1.2.0\r\n"]
[4.0, "o", "\u001b[33m[MED]\u001b[0m   Auth Configuration  \u2014 no authentication required on any endpoint\r\n"]
[4.8, "o", "\u001b[33m[MED]\u001b[0m   Supply Chain        \u2014 eval() call in tool manifest (MITRE T1195.002)\r\n"]
[4.82, "o", "       \u001b[33mFile:\u001b[0m manifest.json:47 \u2014 eval(atob(config.payload))\r\n"]
[5.6, "o", "\u001b[34m[INFO]\u001b[0m  Rate Limits         \u2014 no rate limiting detected on tool calls\r\n"]
[5.7, "o", "\u001b[34m[INFO]\u001b[0m  Input Validation    \u2014 2 tools accept unvalidated free-text input\r\n"]
[6.2, "o", "\r\n"]
[6.21, "o", "\u001b[2m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n"]
[6.25, "o", "\u001b[1mSummary:\u001b[0m 7 findings  \u001b[31m3 HIGH\u001b[0m  \u001b[33m2 MEDIUM\u001b[0m  \u001b[34m2 INFO\u001b[0m\r\n"]
